# Local development values are printed by `make db.start` (or `supabase status`).
# Copy this file to .env.local and fill the values.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Collaborator form (Resend). Get a key at https://resend.com.
# COLLABORATOR_FROM_EMAIL must be a verified sender on your Resend domain.
RESEND_API_KEY=""
COLLABORATOR_FROM_EMAIL="Lumia <onboarding@resend.dev>"
COLLABORATOR_TO_EMAIL="info@clinicalumia.es"

# Consent form (/consentimiento): the signed PDF is emailed to CONSENT_TO_EMAIL.
CONSENT_TO_EMAIL="info@clinicalumia.es"

# Instagram feed (official Instagram API with Instagram Login).
# The account must be professional (Business or Creator). In Meta for Developers,
# create a Business app, open Instagram > API setup and click "Generate token"
# next to @clinicalumiaxativa. The token lasts 60 days; renew it before expiry with:
#   curl "https://graph.instagram.com/refresh_access_token?grant_type=ig_refresh_token&access_token=$INSTAGRAM_ACCESS_TOKEN"
# and paste the returned access_token here. Leave empty to show grey placeholders.
INSTAGRAM_ACCESS_TOKEN=""

# Captcha (Cloudflare Turnstile) for /acceder and /consentimiento.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile with the
# hostnames clinicalumia.es and www.clinicalumia.es (see specs/operacion.md).
# Read at request time: set both in Vercel (Production only) and redeploy, no code
# change needed. Leave either empty to keep the captcha off; it only turns on with both.
# The server only accepts answers solved on clinicalumia.es or www.clinicalumia.es,
# so leave them empty in local development and in Preview deployments.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
