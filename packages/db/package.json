{
  "name": "@clinicalumia/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./types.ts",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > types.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrations": "tsx scripts/migrations-cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@clinicalumia/config": "workspace:*",
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
