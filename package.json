{
  "name": "clinicalumia",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "bash scripts/dev-banner.sh && turbo run dev",
    "lint": "biome check .",
